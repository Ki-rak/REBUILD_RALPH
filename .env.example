# RE:Build Agent — server only. Never commit actual .env or credentials.
# local/demo -> official Codex ChatGPT OAuth. deployed -> OpenAI API key.
REBUILD_ENV=local
# Optional local Codex model. Empty uses the authenticated account default.
CODEX_MODEL=
# Deployed adapter only; these are never used for local OAuth.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Supabase project: wsziosnttnxefgfbgpeq
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Stable server-only integrity key. Generate once; never expose or rotate casually.
REBUILD_APPROVAL_SIGNING_KEY=
